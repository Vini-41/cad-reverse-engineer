#!/usr/bin/env bash
# Formats the staged Python with the repo's ruff, so scripts/check's "ruff format" step passes.
# scripts/check sets core.hooksPath to this folder. A file with unstaged changes is not
# re-staged: the commit stops and names it, since formatting it would stage those changes too.
set -euo pipefail

tool="$(cd "$(dirname "$0")/.." && pwd)/skills/cad-reverse-engineer/tool"
ruff() { uv run -q --project "$tool" ruff format --force-exclude "$@"; }

clean=() partial=()
while IFS= read -r -d '' f; do
  if git diff --quiet -- "$f"; then clean+=("$f"); else partial+=("$f"); fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.py' 'scripts/*')

stop=0
for f in ${partial[@]+"${partial[@]}"}; do
  if ! ruff --check "$f" >/dev/null 2>&1; then
    echo "pre-commit: ruff would reformat $f, which has unstaged changes; stage or stash them" >&2
    stop=1
  fi
done
[ "$stop" -eq 0 ] || exit 1

[ ${#clean[@]} -gt 0 ] || exit 0
ruff "${clean[@]}" >/dev/null
changed=()
for f in "${clean[@]}"; do git diff --quiet -- "$f" || changed+=("$f"); done
[ ${#changed[@]} -gt 0 ] || exit 0
git add -- "${changed[@]}"
echo "pre-commit: ruff formatted ${changed[*]}"
