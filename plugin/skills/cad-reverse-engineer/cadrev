#!/bin/sh
# Runs the cadrev CLI in tool/ beside this script, from any directory: SKILL.md's Tool section.
# --locked installs exactly the versions in tool/uv.lock, and fails rather than re-resolve them.
#
# A sandbox such as Codex's workspace-write lets cadrev write the workspace and TMPDIR, but not
# ~/.cache, the Matplotlib directory under HOME, or the installed plugin's tool/.venv. Each of
# those that cannot be written moves to a directory of this user's under TMPDIR (#181).
tool=$(cd "$(dirname "$0")/tool" && pwd)

# writable PATH: whether PATH, or the nearest directory above it that exists, can be written.
writable() {
  p=$1
  while [ ! -e "$p" ]; do p=$(dirname "$p"); done
  [ -w "$p" ]
}

# moved VAR DIR: sets VAR to DIR, made under the fallback directory.
moved() {
  mkdir -p "$2" && export "$1=$2"
}

tmp="${TMPDIR:-/tmp}"
tmp="${tmp%/}/cadrev-$(id -u)"
# /tmp is shared, so the fallback is used only when this user owns it.
if mkdir -p -m 700 "$tmp" 2>/dev/null && [ -O "$tmp" ] && [ -w "$tmp" ]; then
  writable "${UV_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/uv}" || moved UV_CACHE_DIR "$tmp/cache/uv"
  # fontconfig's cache, and Matplotlib's on Linux
  writable "${XDG_CACHE_HOME:-$HOME/.cache}" || moved XDG_CACHE_HOME "$tmp/cache"
  case $(uname) in
    Darwin) mpl="$HOME/.matplotlib" ;;
    *) mpl="${XDG_CONFIG_HOME:-$HOME/.config}/matplotlib" ;;
  esac
  writable "${MPLCONFIGDIR:-$mpl}" || moved MPLCONFIGDIR "$tmp/matplotlib"
  # one environment per installed copy of the plugin, named by its path; uv makes it
  if ! writable "${UV_PROJECT_ENVIRONMENT:-$tool/.venv}"; then
    UV_PROJECT_ENVIRONMENT="$tmp/venv-$(printf %s "$tool" | cksum | cut -d ' ' -f 1)"
    export UV_PROJECT_ENVIRONMENT
  fi
fi

exec uv run -q --locked --project "$tool" cadrev "$@"
