#!/usr/bin/env bash
# Copies the repo's examples as a commit of its index would hold them, a clone after committing:
# each tracked or staged file at its staged text, without unstaged edits, untracked files or
# build/. Prints the copy's examples directory, in a new temporary directory the caller removes.
#
#   scripts/committed-examples
set -euo pipefail

repo=$(git rev-parse --show-toplevel)  # the repo of the directory it runs in
dir=$(mktemp -d)
git -C "$repo" ls-files -z -- examples | git -C "$repo" checkout-index -z --stdin --prefix="$dir/"
echo "$dir/examples"
