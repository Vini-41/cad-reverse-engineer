#!/usr/bin/env python3
"""Wait for every CI run on a pushed commit and exit with their result: 0 when each succeeds, 1 when
any fails or none starts, and 2 when the argument names no commit. A PR's head commit has a push run
and a pull_request run, which compare against different bases, so each is watched and printed with
its event. A failed run's log is read for what failed in each job: scripts/check's failed steps and
pytest's FAILED lines and counts.

The runs are found by the commit's full SHA (gh run list --commit matches no short one), never by
which run is newest; after each is watched the list is read again, for a run that started late.
When no run starts within the wait, it reads where the current branch is on GitHub: at the commit,
the push event was lost, and it names the command that reruns CI there.

    scripts/ci-wait [commit, default HEAD]

GH names the gh executable (default gh); CI_WAIT_SECONDS how long to look for the run (default
120), and CI_WAIT_POLL how often (default 6).
"""

import os
import re
import subprocess
import sys
import time

GH = os.environ.get("GH", "gh")


def out(*args: str) -> str:
    return subprocess.run(args, capture_output=True, text=True, check=True).stdout.strip()


def list_runs(sha: str) -> list[tuple[str, str]]:
    """Each CI run on sha as (id, event), oldest first."""
    listed = out(
        GH,
        "run",
        "list",
        "--commit",
        sha,
        "--json",
        "databaseId,event",
        "--jq",
        'reverse | .[] | "\\(.databaseId)\\t\\(.event)"',
    )
    return [
        (run, event) for run, _, event in (line.partition("\t") for line in listed.splitlines())
    ]


def find_runs(sha: str) -> list[tuple[str, str]]:
    """The CI runs on sha, waiting up to CI_WAIT_SECONDS for one to start; [] if none."""
    deadline = time.monotonic() + float(os.environ.get("CI_WAIT_SECONDS", 120))
    while True:
        runs = list_runs(sha)
        if runs or time.monotonic() >= deadline:
            return runs
        time.sleep(float(os.environ.get("CI_WAIT_POLL", 6)))


# A line of a failed log worth printing: scripts/check's failed step, a pytest FAILED line or count.
FAILURE = re.compile(r"failed: |FAILED |\d+ failed")


def failures(run: str) -> list[str]:
    """What failed in each job of run, as `<job>: <line>`, from its log of failed steps, whose
    lines are job, step and a timestamped message, tab-separated."""
    found = []
    for line in out(GH, "run", "view", run, "--log-failed").splitlines():
        job, _, rest = line.split("\t", 2) if line.count("\t") >= 2 else ("", "", "")
        message = rest.split(" ", 1)[-1].strip()
        # scripts/check echoes a failed step's output after it ran, so a line can come twice.
        if FAILURE.match(message) and f"{job}: {message}" not in found:
            found.append(f"{job}: {message}")
    return found


def watch(sha: str, run: str, event: str) -> int:
    """Watch run to its end and print its conclusion, and what failed if it failed: 0 on success."""
    watched = subprocess.run([GH, "run", "watch", run, "--exit-status"], capture_output=True)
    conclusion = out(GH, "run", "view", run, "--json", "conclusion", "--jq", ".conclusion")
    print(f"CI {conclusion} on {sha} ({event} run {run})")
    if watched.returncode == 0 and conclusion == "success":
        return 0
    for failure in failures(run) if conclusion == "failure" else []:
        print(failure)
    return 1


def main() -> int:
    arg = sys.argv[1] if len(sys.argv) > 1 else "HEAD"
    if arg in ("-h", "--help"):
        print(__doc__)
        return 0
    # --end-of-options, since rev-parse echoes an option it does not know as if it were a commit
    found = subprocess.run(
        ["git", "rev-parse", "--verify", "-q", "--end-of-options", f"{arg}^{{commit}}"],
        capture_output=True,
        text=True,
    )
    if found.returncode != 0:
        print(f"{arg} names no commit", file=sys.stderr)
        return 2
    sha = found.stdout.strip()
    runs = find_runs(sha)
    if runs:
        code, watched = 0, set()
        while pending := [(run, event) for run, event in runs if run not in watched]:
            for run, event in pending:
                code = max(code, watch(sha, run, event))
                watched.add(run)
            runs = list_runs(sha)
        return code
    branch = out("git", "symbolic-ref", "--short", "HEAD")
    remote = out(GH, "api", f"repos/{{owner}}/{{repo}}/branches/{branch}", "--jq", ".commit.sha")
    print(f"no CI run started on {sha}", file=sys.stderr)
    if remote == sha:
        print(
            f"{branch} on GitHub is at it, so its push event was lost: rerun CI with "
            f"`gh workflow run test.yml --ref {branch}`, then scripts/ci-wait again",
            file=sys.stderr,
        )
    else:
        print(f"{branch} on GitHub is at {remote}, not {sha}: push it first", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
