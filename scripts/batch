#!/usr/bin/env python3
"""Work a queue of ready tickets headless: plan waves, implement each ticket in its own worktree
with a headless agent, then merge the green ones one at a time.

    scripts/batch [issue ...] [--milestone M] [--max 3] [--dry-run] [--foreground]
    scripts/batch --status

With no issue numbers it takes every open `ready-for-agent` issue (in milestone M, if given) that
no open issue blocks. A ticket's body names the paths it changes on a line `Touches: a/, b.py`;
tickets whose paths don't overlap share a wave of at most --max, and one with no Touches line runs
alone. --dry-run prints the waves and stops.

A batch detaches once it has printed its waves: it starts itself again in a new session with no
terminal and returns, so it runs to the end whatever started it, such as an agent session that ends
between messages. --foreground runs it in the calling process. While it runs,
.scratch/batches/running holds its pid and stamp, and a second batch refuses to start; a lock whose
pid no longer runs a batch is taken over. The detached batch works the waves printed, saved in
waves.json. --status prints the running batch's last steps and each running agent's latest
action, or the latest summary.

Each ticket's agent runs `claude -p` in `.claude/worktrees/batch-<n>`, on branch `batch/<n>` cut
from origin/main, briefed by docs/agents/batch-ticket.md, and writes its result file: `done` and
a PR summary, or `needs-info` and the question it needs answered. After each wave the runner, in
plan order, rebases each done branch onto origin/main, pushes it, opens its PR (`Part of #<n>`)
and waits for CI with scripts/ci-wait. It merges the PR with `gh pr merge --rebase` unless the PR
changes a protected path (what users read, or the gate itself), which waits for the user. Once CI
is green on main it closes the issue. A rebase conflict or a red CI gets the agent once more; if it
still fails, or the agent asked a question, the issue gets the question and `needs-info`, its
commits are pushed to `batch/<n>`, where a later batch from any checkout carries on, and the batch
goes on. Red CI on main stops the batch.

Everything lands in .scratch/batches/<stamp>/: batch.log (the runner's own output), progress.log
(one line per step), one log per agent run (its stream-json, written as it works, beside a .pid
file while it runs) and summary.md, which says what merged, what waits for the user and why, and
each question. The batch ends with a desktop notification.

CLAUDE, GH and CI_WAIT name the executables (default claude, gh and scripts/ci-wait);
BATCH_TICKET_SECONDS caps one agent run (default 10800); CADREV_PROJECTS is the evidence dir the
agents may write in (default ~/Documents/Projects/cadrev); BATCH_NOTIFY=0 skips the notification.
"""

import argparse
import datetime
import json
import os
import subprocess
import sys
from pathlib import Path, PurePosixPath

ROOT = Path(__file__).resolve().parents[1]
GH = os.environ.get("GH", "gh")
CLAUDE = os.environ.get("CLAUDE", "claude")
CI_WAIT = os.environ.get("CI_WAIT", str(ROOT / "scripts" / "ci-wait"))
TICKET_SECONDS = int(os.environ.get("BATCH_TICKET_SECONDS", "10800"))
PROJECTS = Path(os.environ.get("CADREV_PROJECTS", "~/Documents/Projects/cadrev")).expanduser()
BRIEF = ROOT / "docs" / "agents" / "batch-ticket.md"
BATCHES = ROOT / ".scratch" / "batches"
LOCK = BATCHES / "running"

# A change to any of these waits for the user: what a user reads, and what gates or steers agents.
PROTECTED_FILES = {"LICENSE", "README.md", "SKILL.md"}
PROTECTED_DIRS = {"references", ".claude-plugin", ".codex-plugin"}
PROTECTED_ROOTS = {".github", ".claude", ".agents", "docs/agents"}
PROTECTED_SCRIPTS = {"scripts/check", "scripts/batch", "scripts/ci-wait", "scripts/red-on-main"}


def run(*args: str, cwd: Path = ROOT, check: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True, check=check)


def out(*args: str, cwd: Path = ROOT) -> str:
    return run(*args, cwd=cwd, check=True).stdout.strip()


def protected(path: str) -> bool:
    p = PurePosixPath(path)
    return (
        p.name in PROTECTED_FILES
        or any(part in PROTECTED_DIRS for part in p.parts[:-1])
        or any(path == r or path.startswith(r + "/") for r in PROTECTED_ROOTS)
        or path in PROTECTED_SCRIPTS
    )


def touches(body: str) -> list[str] | None:
    """The paths a ticket's `Touches:` line names, or None when it has none."""
    for line in body.splitlines():
        if line.strip().lower().startswith("touches:"):
            paths = [p.strip().strip("`") for p in line.split(":", 1)[1].split(",")]
            return [p.rstrip("/") for p in paths if p] or None
    return None


def overlap(a: list[str] | None, b: list[str] | None) -> bool:
    if a is None or b is None:
        return True
    return any(x == y or x.startswith(y + "/") or y.startswith(x + "/") for x in a for y in b)


def plan(tickets: list[dict], size: int) -> list[list[dict]]:
    """Waves in ticket order: a ticket joins the last wave when it fits there, else starts the
    next, so a ticket never runs before one listed ahead of it."""
    waves: list[list[dict]] = []
    for t in tickets:
        last = waves[-1] if waves else None
        if last and len(last) < size and not any(overlap(t["touches"], o["touches"]) for o in last):
            last.append(t)
        else:
            waves.append([t])
    return waves


def ticket(data: dict) -> dict:
    return {
        "number": data["number"],
        "title": data["title"],
        "touches": touches(data.get("body") or ""),
    }


def blocked(number: int) -> bool:
    summary = out(
        GH,
        "api",
        f"repos/{{owner}}/{{repo}}/issues/{number}",
        "--jq",
        ".issue_dependencies_summary.blocked_by // 0",
    )
    return int(summary or 0) > 0


def select(numbers: list[int], milestone: str | None) -> list[dict]:
    fields = "number,title,body,labels"
    if numbers:
        return [
            ticket(json.loads(out(GH, "issue", "view", str(n), "--json", fields))) for n in numbers
        ]
    args = [
        GH,
        "issue",
        "list",
        "--state",
        "open",
        "--label",
        "ready-for-agent",
        "--limit",
        "100",
        "--json",
        fields,
    ]
    if milestone:
        args += ["--milestone", milestone]
    listed = sorted(json.loads(out(*args)), key=lambda i: i["number"])
    ready = [i for i in listed if "needs-info" not in {lab["name"] for lab in i["labels"]}]
    return [ticket(i) for i in ready if not blocked(i["number"])]


def alive(pid: int) -> bool:
    """Whether pid is a running batch: a pid the system gave another program after a batch was
    killed holds no batch."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return "scripts/batch" in run("ps", "-p", str(pid), "-o", "command=").stdout


def running() -> tuple[int, str] | None:
    """The pid and stamp of the batch that holds the lock, if it is still running."""
    try:
        pid, stamp = LOCK.read_text().split()
    except (OSError, ValueError):
        return None
    return (int(pid), stamp) if alive(int(pid)) else None


def write_lock(pid: int, stamp: str, *, take: bool) -> bool:
    """Write the lock whole, in one step: take it only where no lock is (False if one is), else
    replace it."""
    BATCHES.mkdir(parents=True, exist_ok=True)
    tmp = BATCHES / f"running.{os.getpid()}"
    tmp.write_text(f"{pid} {stamp}\n")
    try:
        if not take:
            os.replace(tmp, LOCK)
            return True
        os.link(tmp, LOCK)
        return True
    except FileExistsError:
        return False
    finally:
        tmp.unlink(missing_ok=True)


def acquire(stamp: str) -> tuple[int, str] | None:
    """Take the lock for this process, or return the pid and stamp of the batch holding it. A lock
    whose batch is gone is taken over."""
    for _ in range(2):
        if write_lock(os.getpid(), stamp, take=True):
            return None
        held = running()
        if held:
            return held
        LOCK.unlink(missing_ok=True)
    return running() or (0, "unknown")


def unlock() -> None:
    """Remove the lock if this process holds it."""
    try:
        holder = int(LOCK.read_text().split()[0])
    except (OSError, ValueError, IndexError):
        return
    if holder == os.getpid():
        LOCK.unlink(missing_ok=True)


def latest_action(log: Path, tail: int = 256 * 1024) -> str | None:
    """The last tool call or text in an agent's stream-json log, on one line. Only the log's end is
    read, as a log holds every tool result; a line it cuts is skipped, as is one not yet whole."""
    with log.open("rb") as f:
        f.seek(max(0, log.stat().st_size - tail))
        lines = f.read().decode(errors="replace").splitlines()
    for line in reversed(lines):
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict) or event.get("type") != "assistant":
            continue
        message = event.get("message")
        if not isinstance(message, dict):
            continue
        content = message.get("content")
        for item in reversed(content if isinstance(content, list) else []):
            if not isinstance(item, dict):
                continue
            if item.get("type") == "tool_use":
                given = item.get("input") if isinstance(item.get("input"), dict) else {}
                keys = ("command", "file_path", "pattern", "description")
                what = next((str(given[k]) for k in keys if k in given), "")
                text = f"{item.get('name')}: {what}"
            elif item.get("type") == "text" and str(item.get("text", "")).strip():
                text = str(item["text"]).strip()
            else:
                continue
            text = " ".join(text.split("\n", 1)[0].split())
            return text if len(text) <= 120 else text[:117] + "..."
    return None


def agents_now(folder: Path) -> list[str]:
    """A line for each agent still running, as its .pid file names a live process: the latest
    action in its log."""
    lines = []
    for pidfile in sorted(folder.glob("*.*.pid"), key=lambda p: int(p.name.split(".")[0])):
        n, tag = pidfile.name.split(".")[:2]
        log = folder / f"{n}.{tag}.log"
        try:
            pid = int(pidfile.read_text())
            os.kill(pid, 0)
        except (OSError, ValueError):
            continue
        action = latest_action(log) if log.exists() else None
        if action:
            lines.append(f"#{n} {tag}, now: {action}")
    return lines


def status() -> str:
    held = running()
    if held:
        pid, stamp = held
        progress = BATCHES / stamp / "progress.log"
        lines = progress.read_text().splitlines()[-8:] if progress.exists() else []
        log = BATCHES / stamp / "batch.log"
        lines += agents_now(BATCHES / stamp)
        return "\n".join([f"batch {stamp} running, pid {pid}", f"log: {log}", *lines]) + "\n"
    dirs = sorted(d for d in BATCHES.glob("*") if d.is_dir()) if BATCHES.is_dir() else []
    if not dirs:
        return "no batch running, and none has run\n"
    summary = dirs[-1] / "summary.md"
    if not summary.exists():
        return (
            f"no batch running; the latest batch {dirs[-1].name} ended without a summary: "
            f"see its logs in {dirs[-1]}\n"
        )
    return f"no batch running; the latest is {summary}\n\n" + summary.read_text()


class Batch:
    def __init__(self, stamp: str):
        self.dir = BATCHES / stamp
        self.dir.mkdir(parents=True, exist_ok=True)
        self.merged: list[str] = []
        self.waiting: list[str] = []
        self.questions: list[str] = []
        self.stopped = ""

    def note(self, text: str) -> None:
        """One step, in progress.log, for --status."""
        with (self.dir / "progress.log").open("a") as f:
            f.write(f"{datetime.datetime.now():%H:%M:%S} {text}\n")

    # The agent.

    def settings(self) -> str:
        """Deny edits to every dogfood run that already exists, and the runner's own jobs."""
        runs = (
            sorted((PROJECTS / "dogfood").glob("run-*")) if (PROJECTS / "dogfood").is_dir() else []
        )
        deny = [f"Edit({r}/**)" for r in runs] + [
            "Bash(rm -rf *)",
            "Bash(git push *)",
            "Bash(gh pr merge *)",
            "Bash(gh pr create *)",
            "Bash(gh issue close *)",
            "Bash(gh issue edit *)",
            "Bash(gh issue comment *)",
        ]
        return json.dumps({"permissions": {"deny": deny}})

    def agent(self, t: dict, tree: Path, task: str, tag: str) -> None:
        result = self.dir / f"{t['number']}.result.md"
        result.unlink(missing_ok=True)
        prompt = (
            BRIEF.read_text()
            .replace("<n>", str(t["number"]))
            .replace("<result>", str(result))
            .replace("<task>", f"Issue #{t['number']}, branch {self.branch(t)}. {task}")
        )
        args = [
            CLAUDE,
            "-p",
            prompt,
            "--permission-mode",
            "auto",
            "--output-format",
            "stream-json",
            "--verbose",
            "--add-dir",
            str(self.dir),
            "--settings",
            self.settings(),
        ]
        if PROJECTS.is_dir():
            args += ["--add-dir", str(PROJECTS)]
        log = self.dir / f"{t['number']}.{tag}.log"
        self.note(f"#{t['number']} {tag}: agent started")
        with log.open("w") as f:
            proc = subprocess.Popen(
                args,
                cwd=tree,
                stdin=subprocess.DEVNULL,
                stdout=f,
                stderr=subprocess.STDOUT,
                text=True,
            )
            (self.dir / f"{t['number']}.{tag}.pid").write_text(str(proc.pid))
            t.setdefault("procs", []).append((proc, self.dir / f"{t['number']}.{tag}.pid"))

    def wait(self, wave: list[dict]) -> None:
        for t in wave:
            for proc, pidfile in t.pop("procs", []):
                try:
                    proc.wait(timeout=TICKET_SECONDS)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
                pidfile.unlink(missing_ok=True)

    def result(self, t: dict) -> tuple[str, str]:
        path = self.dir / f"{t['number']}.result.md"
        if not path.exists():
            self.note(f"#{t['number']}: the agent wrote no result")
            return "needs-info", "The agent ended without writing its result; see its log."
        head, _, body = path.read_text().partition("\n")
        self.note(f"#{t['number']}: the agent's result is {head.strip().lower()}")
        return head.strip().lower(), body.strip()

    # Git and GitHub.

    def tree(self, t: dict) -> Path:
        return ROOT / ".claude" / "worktrees" / f"batch-{t['number']}"

    def branch(self, t: dict) -> str:
        return f"batch/{t['number']}"

    def start(self, t: dict) -> None:
        """Cut the ticket's worktree, or reuse the one an earlier batch left at a question. A
        ticket that stopped at a question in another checkout carries on from its pushed branch."""
        if not self.tree(t).exists():
            run("git", "fetch", "-q", "origin", check=True)
            pushed = f"origin/{self.branch(t)}"
            base = (
                pushed
                if run("git", "rev-parse", "-q", "--verify", pushed).returncode == 0
                else "origin/main"
            )
            run(
                "git",
                "worktree",
                "add",
                "-q",
                "-B",
                self.branch(t),
                str(self.tree(t)),
                base,
                check=True,
            )
        task = (
            "Implement it test-first: read the issue with `gh issue view "
            f"{t['number']} --comments`, then write each test red before the change that "
            "turns it green."
        )
        self.agent(t, self.tree(t), task, "implement")

    def ask(self, t: dict, question: str) -> None:
        """Put question on the ticket, and push its commits, so any checkout can carry on."""
        if (
            self.tree(t).exists()
            and out("git", "rev-list", "--count", "origin/main..HEAD", cwd=self.tree(t)) != "0"
        ):
            run(
                "git",
                "push",
                "-q",
                "--force-with-lease",
                "-u",
                "origin",
                self.branch(t),
                cwd=self.tree(t),
            )
        body = f"The batch runner stopped on this ticket.\n\n{question}"
        run(GH, "issue", "comment", str(t["number"]), "--body", body)
        run(
            GH,
            "issue",
            "edit",
            str(t["number"]),
            "--add-label",
            "needs-info",
            "--remove-label",
            "ready-for-agent",
        )
        self.questions.append(f"#{t['number']} {t['title']}: {question}")
        self.note(f"#{t['number']}: needs-info, its question is on the issue")

    def ahead(self, t: dict) -> bool:
        count = out("git", "rev-list", "--count", "origin/main..HEAD", cwd=self.tree(t))
        return int(count) > 0

    def rebase(self, t: dict) -> bool:
        tree = self.tree(t)
        self.note(f"#{t['number']}: rebasing onto origin/main")
        run("git", "fetch", "-q", "origin", cwd=tree, check=True)
        if run("git", "rebase", "-q", "origin/main", cwd=tree).returncode == 0:
            return True
        conflicted = out("git", "diff", "--name-only", "--diff-filter=U", cwd=tree)
        run("git", "rebase", "--abort", cwd=tree)
        task = (
            f"Rebase this branch onto origin/main; it conflicts in: {conflicted}. Resolve a "
            "textual overlap and finish the rebase with scripts/check green. Where the two "
            "changes disagree in logic, abort the rebase and ask instead."
        )
        self.agent(t, tree, task, "rebase")
        self.wait([t])
        status, _ = self.result(t)
        clean = run("git", "merge-base", "--is-ancestor", "origin/main", "HEAD", cwd=tree)
        return status == "done" and clean.returncode == 0

    def push(self, t: dict) -> str:
        tree = self.tree(t)
        run(
            "git",
            "push",
            "-q",
            "--force-with-lease",
            "-u",
            "origin",
            self.branch(t),
            cwd=tree,
            check=True,
        )
        sha = out("git", "rev-parse", "HEAD", cwd=tree)
        self.note(f"#{t['number']}: pushed {sha[:7]} to {self.branch(t)}")
        return sha

    def ci(self, name: str, sha: str) -> tuple[bool, str]:
        """ci-wait's result on sha, its output written to <name>.ci.log, since it refuses a pipe."""
        log = self.dir / f"{name}.ci.log"
        self.note(f"#{name}: waiting for CI on {sha[:7]}")
        with open(log, "w") as f:
            waited = subprocess.run([CI_WAIT, sha], cwd=ROOT, stdout=f, stderr=subprocess.STDOUT)
        self.note(f"#{name}: CI {'green' if waited.returncode == 0 else 'red'} on {sha[:7]}")
        return waited.returncode == 0, log.read_text()

    def pr(self, t: dict, summary: str) -> str:
        found = run(GH, "pr", "view", self.branch(t), "--json", "number", "--jq", ".number")
        if found.returncode == 0 and found.stdout.strip():
            return found.stdout.strip()
        own = f"Part of #{t['number']}"
        head, _, rest = summary.partition("\n")
        if head.strip() == own:
            summary = rest.lstrip()
        body = f"{own}\n\n{summary}\n\nOpened by scripts/batch."
        url = out(
            GH,
            "pr",
            "create",
            "--base",
            "main",
            "--head",
            self.branch(t),
            "--title",
            f"{t['title']} (#{t['number']})",
            "--body",
            body,
        )
        return url.rstrip("/").rsplit("/", 1)[-1]

    def changed(self, t: dict) -> list[str]:
        return out(
            "git", "diff", "--name-only", "origin/main...HEAD", cwd=self.tree(t)
        ).splitlines()

    def land(self, t: dict, summary: str) -> None:
        """Rebase, push, PR, CI, then merge unless protected; record what happened."""
        n, tree = t["number"], self.tree(t)
        if not self.rebase(t):
            return self.ask(t, "Its branch conflicts with main in logic; see the rebase log.")
        sha = self.push(t)
        pr = self.pr(t, summary)
        self.note(f"#{n}: PR #{pr}")
        green, report = self.ci(str(n), sha)
        if not green:
            task = f"CI failed on this branch. Fix it with scripts/check green.\n\n{report}"
            self.agent(t, tree, task, "ci-fix")
            self.wait([t])
            if self.result(t)[0] == "done" and self.rebase(t):
                green, report = self.ci(str(n), self.push(t))
        if not green:
            return self.ask(t, f"CI stays red on PR #{pr} after one fix:\n\n```\n{report}\n```")
        held = [p for p in self.changed(t) if protected(p)]
        if held:
            self.waiting.append(f"#{n} {t['title']}: PR #{pr} changes {', '.join(held)}")
            self.note(f"#{n}: PR #{pr} is green and waits for the user")
            return
        if run(GH, "pr", "merge", pr, "--rebase", "--delete-branch").returncode:
            self.waiting.append(
                f"#{n} {t['title']}: PR #{pr} is green but GitHub refused the merge"
            )
            return
        self.note(f"#{n}: merged PR #{pr}")
        run("git", "fetch", "-q", "origin", check=True)
        main = out("git", "rev-parse", "origin/main")
        green, report = self.ci(f"{n}.main", main)
        if not green:
            self.stopped = f"CI is red on main at {main} after merging PR #{pr}:\n\n{report}"
            return
        departures = summary.split("Departures:", 1)[1].strip() if "Departures:" in summary else ""
        if departures:
            run(
                GH,
                "issue",
                "comment",
                str(n),
                "--body",
                f"Departures from the brief:\n\n{departures}",
            )
        run(GH, "issue", "close", str(n), "--comment", f"Landed in {main}; CI green on {main}.")
        run("git", "worktree", "remove", "--force", str(tree))
        self.merged.append(f"#{n} {t['title']}: PR #{pr}, {main[:7]}")
        self.note(f"#{n}: closed, landed in {main[:7]}")

    def work(self, waves: list[list[dict]]) -> None:
        for wave in waves:
            for t in wave:
                self.start(t)
            self.wait(wave)
            for t in wave:
                status, body = self.result(t)
                if status != "done":
                    self.ask(t, body or "The agent stopped without saying why; see its log.")
                elif not self.ahead(t):
                    self.ask(t, "The agent reported done but committed nothing.")
                else:
                    self.land(t, body)
                if self.stopped:
                    return

    def summary(self) -> Path:
        def section(title: str, items: list[str]) -> str:
            return f"## {title}\n\n" + ("\n".join(f"- {i}" for i in items) or "None.") + "\n"

        text = "# Batch " + self.dir.name + "\n\n"
        if self.stopped:
            text += f"**Stopped.** {self.stopped}\n\n"
        text += section("Merged", self.merged) + "\n" + section("Waiting for you", self.waiting)
        text += "\n" + section("Needs info", self.questions)
        path = self.dir / "summary.md"
        path.write_text(text)
        self.note("batch done: summary.md written")
        return path


def notify(text: str) -> None:
    if os.environ.get("BATCH_NOTIFY", "1") != "0" and sys.platform == "darwin":
        run("osascript", "-e", f'display notification {json.dumps(text)} with title "cadrev batch"')


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("issues", nargs="*", type=int)
    parser.add_argument("--milestone")
    parser.add_argument("--max", type=int, default=3)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--foreground", action="store_true")
    parser.add_argument("--status", action="store_true")
    # The detached batch: it works the waves its starter printed, under the lock it was handed.
    parser.add_argument("--child", metavar="STAMP", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.status:
        print(status(), end="")
        return 0
    if args.child:
        waves = json.loads((BATCHES / args.child / "waves.json").read_text())
        try:
            return work(waves, args.child)
        finally:
            unlock()
    stamp = datetime.datetime.now().strftime("%Y-%m-%d-%H%M")
    if not args.dry_run:
        held = acquire(stamp)
        if held:
            print(
                f"batch {held[1]} is running, pid {held[0]}: see scripts/batch --status",
                file=sys.stderr,
            )
            return 1
    try:
        waves = plan(select(args.issues, args.milestone), max(1, args.max))
        for i, wave in enumerate(waves, 1):
            print(f"wave {i}: " + ", ".join(f"#{t['number']} {t['title']}" for t in wave))
        if not waves:
            print("no ready ticket")
        if args.dry_run or not waves:
            return 0
        if args.foreground:
            return work(waves, stamp)
        return detach(stamp, waves)
    finally:
        unlock()


def detach(stamp: str, waves: list[list[dict]]) -> int:
    """Start the batch in a new session with no terminal, and hand it the lock."""
    folder = BATCHES / stamp
    folder.mkdir(parents=True, exist_ok=True)
    (folder / "waves.json").write_text(json.dumps(waves))
    log = folder / "batch.log"
    with log.open("a") as f:
        child = subprocess.Popen(
            [sys.executable, "-u", __file__, "--child", stamp],
            cwd=ROOT,
            stdin=subprocess.DEVNULL,
            stdout=f,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    write_lock(child.pid, stamp, take=False)
    print(f"batch {stamp} running, pid {child.pid}: {folder}")
    print(f"log: {log}")
    print("scripts/batch --status shows its progress")
    return 0


def work(waves: list[list[dict]], stamp: str) -> int:
    batch = Batch(stamp)
    batch.work(waves)
    path = batch.summary()
    print(path.read_text())
    notify(
        f"{len(batch.merged)} merged, {len(batch.waiting)} waiting, "
        f"{len(batch.questions)} questions" + (" (stopped)" if batch.stopped else "")
    )
    return 1 if batch.stopped else 0


if __name__ == "__main__":
    sys.exit(main())
