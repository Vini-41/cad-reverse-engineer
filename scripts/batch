#!/usr/bin/env python3
"""Work a queue of ready tickets headless: plan waves, implement each ticket in its own worktree
with a headless agent, then merge the green ones one at a time.

    scripts/batch [issue ...] [--milestone M] [--max 3] [--dry-run]

With no issue numbers it takes every open `ready-for-agent` issue (in milestone M, if given) that
no open issue blocks. A ticket's body names the paths it changes on a line `Touches: a/, b.py`;
tickets whose paths don't overlap share a wave of at most --max, and one with no Touches line runs
alone. --dry-run prints the waves and stops.

Each ticket's agent runs `claude -p` in `.claude/worktrees/batch-<n>`, on branch `batch/<n>` cut
from origin/main, briefed by docs/agents/batch-ticket.md, and writes its result file: `done` and
a PR summary, or `needs-info` and the question it needs answered. After each wave the runner, in
plan order, rebases each done branch onto origin/main, pushes it, opens its PR (`Part of #<n>`)
and waits for CI with scripts/ci-wait. It merges the PR with `gh pr merge --rebase` unless the PR
changes a protected path (what users read, or the gate itself), which waits for the user. Once CI
is green on main it closes the issue. A rebase conflict or a red CI gets the agent once more; if it
still fails, or the agent asked a question, the issue gets the question and `needs-info`, and the
batch goes on. Red CI on main stops the batch.

Everything lands in .scratch/batches/<stamp>/: one log per agent run and summary.md, which says
what merged, what waits for the user and why, and each question. The batch ends with a desktop
notification.

CLAUDE, GH and CI_WAIT name the executables (default claude, gh and scripts/ci-wait);
BATCH_TICKET_SECONDS caps one agent run (default 10800); CADREV_PROJECTS is the evidence dir the
agents may write in (default ~/Documents/Projects/cadrev); BATCH_NOTIFY=0 skips the notification.
"""

import argparse
import datetime
import json
import os
import subprocess
import sys
from pathlib import Path, PurePosixPath

ROOT = Path(__file__).resolve().parents[1]
GH = os.environ.get("GH", "gh")
CLAUDE = os.environ.get("CLAUDE", "claude")
CI_WAIT = os.environ.get("CI_WAIT", str(ROOT / "scripts" / "ci-wait"))
TICKET_SECONDS = int(os.environ.get("BATCH_TICKET_SECONDS", "10800"))
PROJECTS = Path(os.environ.get("CADREV_PROJECTS", "~/Documents/Projects/cadrev")).expanduser()
BRIEF = ROOT / "docs" / "agents" / "batch-ticket.md"

# A change to any of these waits for the user: what a user reads, and what gates or steers agents.
PROTECTED_FILES = {"LICENSE", "README.md", "SKILL.md"}
PROTECTED_DIRS = {"references", ".claude-plugin", ".codex-plugin"}
PROTECTED_ROOTS = {".github", ".claude", ".agents", "docs/agents"}
PROTECTED_SCRIPTS = {"scripts/check", "scripts/batch", "scripts/ci-wait", "scripts/red-on-main"}


def run(*args: str, cwd: Path = ROOT, check: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True, check=check)


def out(*args: str, cwd: Path = ROOT) -> str:
    return run(*args, cwd=cwd, check=True).stdout.strip()


def protected(path: str) -> bool:
    p = PurePosixPath(path)
    return (
        p.name in PROTECTED_FILES
        or any(part in PROTECTED_DIRS for part in p.parts[:-1])
        or any(path == r or path.startswith(r + "/") for r in PROTECTED_ROOTS)
        or path in PROTECTED_SCRIPTS
    )


def touches(body: str) -> list[str] | None:
    """The paths a ticket's `Touches:` line names, or None when it has none."""
    for line in body.splitlines():
        if line.strip().lower().startswith("touches:"):
            paths = [p.strip().strip("`") for p in line.split(":", 1)[1].split(",")]
            return [p.rstrip("/") for p in paths if p] or None
    return None


def overlap(a: list[str] | None, b: list[str] | None) -> bool:
    if a is None or b is None:
        return True
    return any(x == y or x.startswith(y + "/") or y.startswith(x + "/") for x in a for y in b)


def plan(tickets: list[dict], size: int) -> list[list[dict]]:
    """Waves in ticket order: a ticket joins the last wave when it fits there, else starts the
    next, so a ticket never runs before one listed ahead of it."""
    waves: list[list[dict]] = []
    for t in tickets:
        last = waves[-1] if waves else None
        if last and len(last) < size and not any(overlap(t["touches"], o["touches"]) for o in last):
            last.append(t)
        else:
            waves.append([t])
    return waves


def ticket(data: dict) -> dict:
    return {
        "number": data["number"],
        "title": data["title"],
        "touches": touches(data.get("body") or ""),
    }


def blocked(number: int) -> bool:
    summary = out(
        GH,
        "api",
        f"repos/{{owner}}/{{repo}}/issues/{number}",
        "--jq",
        ".issue_dependencies_summary.blocked_by // 0",
    )
    return int(summary or 0) > 0


def select(numbers: list[int], milestone: str | None) -> list[dict]:
    fields = "number,title,body,labels"
    if numbers:
        return [
            ticket(json.loads(out(GH, "issue", "view", str(n), "--json", fields))) for n in numbers
        ]
    args = [
        GH,
        "issue",
        "list",
        "--state",
        "open",
        "--label",
        "ready-for-agent",
        "--limit",
        "100",
        "--json",
        fields,
    ]
    if milestone:
        args += ["--milestone", milestone]
    listed = sorted(json.loads(out(*args)), key=lambda i: i["number"])
    ready = [i for i in listed if "needs-info" not in {lab["name"] for lab in i["labels"]}]
    return [ticket(i) for i in ready if not blocked(i["number"])]


class Batch:
    def __init__(self, stamp: str):
        self.dir = ROOT / ".scratch" / "batches" / stamp
        self.dir.mkdir(parents=True, exist_ok=True)
        self.merged: list[str] = []
        self.waiting: list[str] = []
        self.questions: list[str] = []
        self.stopped = ""

    # The agent.

    def settings(self) -> str:
        """Deny edits to every dogfood run that already exists, and the runner's own jobs."""
        runs = (
            sorted((PROJECTS / "dogfood").glob("run-*")) if (PROJECTS / "dogfood").is_dir() else []
        )
        deny = [f"Edit({r}/**)" for r in runs] + [
            "Bash(rm -rf *)",
            "Bash(git push *)",
            "Bash(gh pr merge *)",
            "Bash(gh pr create *)",
            "Bash(gh issue close *)",
            "Bash(gh issue edit *)",
            "Bash(gh issue comment *)",
        ]
        return json.dumps({"permissions": {"deny": deny}})

    def agent(self, t: dict, tree: Path, task: str, tag: str) -> None:
        result = self.dir / f"{t['number']}.result.md"
        result.unlink(missing_ok=True)
        prompt = (
            BRIEF.read_text()
            .replace("<n>", str(t["number"]))
            .replace("<result>", str(result))
            .replace("<task>", f"Issue #{t['number']}, branch {self.branch(t)}. {task}")
        )
        args = [
            CLAUDE,
            "-p",
            prompt,
            "--permission-mode",
            "auto",
            "--output-format",
            "json",
            "--add-dir",
            str(self.dir),
            "--settings",
            self.settings(),
        ]
        if PROJECTS.is_dir():
            args += ["--add-dir", str(PROJECTS)]
        log = self.dir / f"{t['number']}.{tag}.log"
        with log.open("w") as f:
            proc = subprocess.Popen(args, cwd=tree, stdout=f, stderr=subprocess.STDOUT, text=True)
            t.setdefault("procs", []).append(proc)

    def wait(self, wave: list[dict]) -> None:
        for t in wave:
            for proc in t.pop("procs", []):
                try:
                    proc.wait(timeout=TICKET_SECONDS)
                except subprocess.TimeoutExpired:
                    proc.kill()

    def result(self, t: dict) -> tuple[str, str]:
        path = self.dir / f"{t['number']}.result.md"
        if not path.exists():
            return "needs-info", "The agent ended without writing its result; see its log."
        head, _, body = path.read_text().partition("\n")
        return head.strip().lower(), body.strip()

    # Git and GitHub.

    def tree(self, t: dict) -> Path:
        return ROOT / ".claude" / "worktrees" / f"batch-{t['number']}"

    def branch(self, t: dict) -> str:
        return f"batch/{t['number']}"

    def start(self, t: dict) -> None:
        """Cut the ticket's worktree, or reuse the one an earlier batch left at a question."""
        if not self.tree(t).exists():
            run("git", "fetch", "-q", "origin", check=True)
            run(
                "git",
                "worktree",
                "add",
                "-q",
                "-B",
                self.branch(t),
                str(self.tree(t)),
                "origin/main",
                check=True,
            )
        task = f"Implement it: run `/mattpocock-skills:implement {t['number']}`."
        self.agent(t, self.tree(t), task, "implement")

    def ask(self, t: dict, question: str) -> None:
        body = f"The batch runner stopped on this ticket.\n\n{question}"
        run(GH, "issue", "comment", str(t["number"]), "--body", body)
        run(
            GH,
            "issue",
            "edit",
            str(t["number"]),
            "--add-label",
            "needs-info",
            "--remove-label",
            "ready-for-agent",
        )
        self.questions.append(f"#{t['number']} {t['title']}: {question}")

    def ahead(self, t: dict) -> bool:
        count = out("git", "rev-list", "--count", "origin/main..HEAD", cwd=self.tree(t))
        return int(count) > 0

    def rebase(self, t: dict) -> bool:
        tree = self.tree(t)
        run("git", "fetch", "-q", "origin", cwd=tree, check=True)
        if run("git", "rebase", "-q", "origin/main", cwd=tree).returncode == 0:
            return True
        conflicted = out("git", "diff", "--name-only", "--diff-filter=U", cwd=tree)
        run("git", "rebase", "--abort", cwd=tree)
        task = (
            f"Rebase this branch onto origin/main; it conflicts in: {conflicted}. Resolve a "
            "textual overlap and finish the rebase with scripts/check green. Where the two "
            "changes disagree in logic, abort the rebase and ask instead."
        )
        self.agent(t, tree, task, "rebase")
        self.wait([t])
        status, _ = self.result(t)
        clean = run("git", "merge-base", "--is-ancestor", "origin/main", "HEAD", cwd=tree)
        return status == "done" and clean.returncode == 0

    def push(self, t: dict) -> str:
        tree = self.tree(t)
        run(
            "git",
            "push",
            "-q",
            "--force-with-lease",
            "-u",
            "origin",
            self.branch(t),
            cwd=tree,
            check=True,
        )
        return out("git", "rev-parse", "HEAD", cwd=tree)

    def ci(self, name: str, sha: str) -> tuple[bool, str]:
        """ci-wait's result on sha, its output written to <name>.ci.log, since it refuses a pipe."""
        log = self.dir / f"{name}.ci.log"
        with open(log, "w") as f:
            waited = subprocess.run([CI_WAIT, sha], cwd=ROOT, stdout=f, stderr=subprocess.STDOUT)
        return waited.returncode == 0, log.read_text()

    def pr(self, t: dict, summary: str) -> str:
        found = run(GH, "pr", "view", self.branch(t), "--json", "number", "--jq", ".number")
        if found.returncode == 0 and found.stdout.strip():
            return found.stdout.strip()
        body = f"Part of #{t['number']}\n\n{summary}\n\nOpened by scripts/batch."
        url = out(
            GH,
            "pr",
            "create",
            "--base",
            "main",
            "--head",
            self.branch(t),
            "--title",
            f"{t['title']} (#{t['number']})",
            "--body",
            body,
        )
        return url.rstrip("/").rsplit("/", 1)[-1]

    def changed(self, t: dict) -> list[str]:
        return out(
            "git", "diff", "--name-only", "origin/main...HEAD", cwd=self.tree(t)
        ).splitlines()

    def land(self, t: dict, summary: str) -> None:
        """Rebase, push, PR, CI, then merge unless protected; record what happened."""
        n, tree = t["number"], self.tree(t)
        if not self.rebase(t):
            return self.ask(t, "Its branch conflicts with main in logic; see the rebase log.")
        sha = self.push(t)
        pr = self.pr(t, summary)
        green, report = self.ci(str(n), sha)
        if not green:
            task = f"CI failed on this branch. Fix it with scripts/check green.\n\n{report}"
            self.agent(t, tree, task, "ci-fix")
            self.wait([t])
            if self.result(t)[0] == "done" and self.rebase(t):
                green, report = self.ci(str(n), self.push(t))
        if not green:
            return self.ask(t, f"CI stays red on PR #{pr} after one fix:\n\n```\n{report}\n```")
        held = [p for p in self.changed(t) if protected(p)]
        if held:
            self.waiting.append(f"#{n} {t['title']}: PR #{pr} changes {', '.join(held)}")
            return
        if run(GH, "pr", "merge", pr, "--rebase", "--delete-branch").returncode:
            self.waiting.append(
                f"#{n} {t['title']}: PR #{pr} is green but GitHub refused the merge"
            )
            return
        run("git", "fetch", "-q", "origin", check=True)
        main = out("git", "rev-parse", "origin/main")
        green, report = self.ci(f"{n}.main", main)
        if not green:
            self.stopped = f"CI is red on main at {main} after merging PR #{pr}:\n\n{report}"
            return
        departures = summary.split("Departures:", 1)[1].strip() if "Departures:" in summary else ""
        if departures:
            run(
                GH,
                "issue",
                "comment",
                str(n),
                "--body",
                f"Departures from the brief:\n\n{departures}",
            )
        run(GH, "issue", "close", str(n), "--comment", f"Landed in {main}; CI green on {main}.")
        run("git", "worktree", "remove", "--force", str(tree))
        self.merged.append(f"#{n} {t['title']}: PR #{pr}, {main[:7]}")

    def work(self, waves: list[list[dict]]) -> None:
        for wave in waves:
            for t in wave:
                self.start(t)
            self.wait(wave)
            for t in wave:
                status, body = self.result(t)
                if status != "done":
                    self.ask(t, body or "The agent stopped without saying why; see its log.")
                elif not self.ahead(t):
                    self.ask(t, "The agent reported done but committed nothing.")
                else:
                    self.land(t, body)
                if self.stopped:
                    return

    def summary(self) -> Path:
        def section(title: str, items: list[str]) -> str:
            return f"## {title}\n\n" + ("\n".join(f"- {i}" for i in items) or "None.") + "\n"

        text = "# Batch " + self.dir.name + "\n\n"
        if self.stopped:
            text += f"**Stopped.** {self.stopped}\n\n"
        text += section("Merged", self.merged) + "\n" + section("Waiting for you", self.waiting)
        text += "\n" + section("Needs info", self.questions)
        path = self.dir / "summary.md"
        path.write_text(text)
        return path


def notify(text: str) -> None:
    if os.environ.get("BATCH_NOTIFY", "1") != "0" and sys.platform == "darwin":
        run("osascript", "-e", f'display notification {json.dumps(text)} with title "cadrev batch"')


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("issues", nargs="*", type=int)
    parser.add_argument("--milestone")
    parser.add_argument("--max", type=int, default=3)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    waves = plan(select(args.issues, args.milestone), max(1, args.max))
    for i, wave in enumerate(waves, 1):
        print(f"wave {i}: " + ", ".join(f"#{t['number']} {t['title']}" for t in wave))
    if not waves:
        print("no ready ticket")
    if args.dry_run or not waves:
        return 0
    batch = Batch(datetime.datetime.now().strftime("%Y-%m-%d-%H%M"))
    batch.work(waves)
    path = batch.summary()
    print(path.read_text())
    notify(
        f"{len(batch.merged)} merged, {len(batch.waiting)} waiting, "
        f"{len(batch.questions)} questions" + (" (stopped)" if batch.stopped else "")
    )
    return 1 if batch.stopped else 0


if __name__ == "__main__":
    sys.exit(main())
