#!/usr/bin/env python3
"""Fail when test coverage of the tool's rules has eroded. Checks that:

- every rule name the tool emits (the literal rule of each p.error, p.warn and Finding) is asserted
  present by one test and asserted absent by another, and is documented as `[rule-name]` in
  plugin/skills/cad-reverse-engineer/references/*.md;
- every error rule is named by a completion criterion of SKILL.md (a "Done when" line, or the line
  of criteria every step shares), as `[rule-name]` or `[prefix-*]`;
- the rows of the test suite's FINDINGS table are in alphabetical order of their rule;
- every unit in cadrev.units.UNITS is read by a row of the test suite's UNITS table: a quote whose
  value the quote reader assigns that unit;
- the tests edit a fixture (a module constant such as MODEL, or a file's read_text()) only through
  swap, which fails when the text it replaces is absent, so an edit never leaves a test vacuous.

    scripts/rule-coverage [repo root, default this script's repo]
        LIST=1 also lists each rule with the tests that assert it

A rule counts as asserted where its name, or `[name]`, appears in an assert's comparison: directly,
through a variable or helper whose value names it, or through a parametrize argument. The comparison
asserts it absent when it uses `not in` or compares with an empty literal (`== []`), present
otherwise; `not` flips it. A conditional assert (`a if c else b`) asserts only what both branches
do. A parametrize argument names the rules of the cases its case list makes, evaluated against the
module's tables where it can be; a test or case marked skip, skipif or xfail asserts nothing.
"""

from __future__ import annotations

import ast
import bisect
import math
import os
import re
import sys
from pathlib import Path

REPO = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else Path(__file__).resolve().parents[1]
SKILL = REPO / "plugin" / "skills" / "cad-reverse-engineer"
SRC = SKILL / "tool" / "src" / "cadrev"
TESTS = REPO / "tests"
sys.path.insert(0, str(SRC.parent))

from cadrev import sources, units  # noqa: E402  (after the path to the tool source)

EMITTERS = {"error": 0, "warn": 0, "Finding": 1}  # the call and the position of its rule argument
BRACKETED = re.compile(r"\[([a-z][a-z0-9-]*)\]")
DONE_NAME = re.compile(r"\[([a-z][a-z0-9-]*)(\*?)\]")  # a rule name, or a prefix ending in "-*"
UNRUN = ("skip", "skipif", "xfail")  # marks under which a test or case may assert nothing
CASE_BUILTINS = {
    f.__name__: f
    for f in (sorted, range, len, enumerate, zip, list, tuple, set, dict, reversed, min, max, sum)
}


class Opaque:
    """A value of a test module's table that a case list cannot read, such as a lambda."""


class Mark:
    def __init__(self, name: str):
        self.name = name

    def __call__(self, *args, **kwargs) -> Mark:
        return self


class Marks:
    def __getattr__(self, name: str) -> Mark:
        return Mark(name)


class Param:
    def __init__(self, *values, marks=(), id=None):
        self.values = values
        self.marks = marks if isinstance(marks, (list, tuple)) else (marks,)


class Pytest:
    """What a case list may read of pytest: pytest.param and pytest.mark.<name>."""

    param = Param
    mark = Marks()


def shape(node: ast.AST, tables: dict):
    """A module-level value as far as a case list can read it: literals, containers and earlier
    tables kept, anything else Opaque."""
    try:
        return ast.literal_eval(node)
    except (ValueError, TypeError, SyntaxError, MemoryError, RecursionError):
        pass
    if isinstance(node, ast.Name) and node.id in tables:
        return tables[node.id]
    if isinstance(node, (ast.List, ast.Tuple)):
        items = [shape(e, tables) for e in node.elts]
        return items if isinstance(node, ast.List) else tuple(items)
    if isinstance(node, ast.Dict):
        out = {}
        for k, v in zip(node.keys, node.values):
            try:
                out[shape(k, tables) if k is not None else Opaque()] = shape(v, tables)
            except TypeError:  # an unhashable key
                return Opaque()
        return out
    return Opaque()


def unrun(deco: ast.AST) -> bool:
    """Whether a decorator marks its test skip, skipif or xfail."""
    func = deco.func if isinstance(deco, ast.Call) else deco
    return any(ast.unparse(func).endswith(f"mark.{m}") for m in UNRUN)


def emitted() -> set[str]:
    """Every rule name the tool source passes as a literal to a finding."""
    rules = set()
    for path in SRC.rglob("*.py"):
        for node in ast.walk(ast.parse(path.read_text(encoding="utf8"))):
            if not isinstance(node, ast.Call):
                continue
            name = (
                node.func.attr
                if isinstance(node.func, ast.Attribute)
                else getattr(node.func, "id", None)
            )
            at = EMITTERS.get(name or "")
            if at is not None and len(node.args) > at:
                arg = node.args[at]
                if isinstance(arg, ast.Constant) and isinstance(arg.value, str):
                    rules.add(arg.value)
    return rules


def emitted_errors() -> set[str]:
    """The rule names the tool source passes as a literal to p.error or to Finding("error", ...)."""
    rules = set()
    for path in SRC.rglob("*.py"):
        for node in ast.walk(ast.parse(path.read_text(encoding="utf8"))):
            if not isinstance(node, ast.Call):
                continue
            literals = [a.value if isinstance(a, ast.Constant) else None for a in node.args]
            if isinstance(node.func, ast.Attribute) and node.func.attr == "error":
                rule = literals[0] if literals else None
            elif getattr(node.func, "id", None) == "Finding" and literals[:1] == ["error"]:
                rule = literals[1] if len(literals) > 1 else None
            else:
                continue
            if isinstance(rule, str):
                rules.add(rule)
    return rules


def unheld_errors() -> list[str]:
    """Error rules that no completion criterion of SKILL.md names, directly or by a prefix."""
    lines = [
        line
        for line in (SKILL / "SKILL.md").read_text().splitlines()
        if line.startswith(("Done when", "Each step ends on a criterion"))
    ]
    names = {(n, bool(star)) for line in lines for n, star in DONE_NAME.findall(line)}
    return sorted(
        rule
        for rule in emitted_errors()
        if not any(rule.startswith(n) if star else rule == n for n, star in names)
    )


class Asserts:
    """The rules each test file asserts present and absent."""

    def __init__(self, rules: set[str]):
        self.rules = rules
        self.present: dict[str, set[str]] = {r: set() for r in rules}
        self.absent: dict[str, set[str]] = {r: set() for r in rules}

    def named(
        self, node: ast.AST, env: dict[str, set[str]], helpers: dict[str, set[str]]
    ) -> set[str]:
        out = set()
        for n in ast.walk(node):
            if isinstance(n, ast.Constant) and isinstance(n.value, str):
                out |= ({n.value} | set(BRACKETED.findall(n.value))) & self.rules
            elif isinstance(n, ast.Name):
                out |= env.get(n.id, set()) | helpers.get(n.id, set())
        return out

    def table(self, node: ast.AST, env, helpers) -> set[str]:
        """What a module-level name holds: a dict's keys, or every rule its value names."""
        if isinstance(node, ast.Dict):
            return set().union(*(self.named(k, env, helpers) for k in node.keys if k is not None))
        return self.named(node, env, helpers)

    def held(self, value) -> set[str]:
        """The rules a case's argument value names."""
        if isinstance(value, str):
            return ({value} | set(BRACKETED.findall(value))) & self.rules
        if isinstance(value, dict):
            return set().union(*(self.held(k) | self.held(v) for k, v in value.items()))
        if isinstance(value, (list, tuple, set)):
            return set().union(*(self.held(v) for v in value))
        return set()

    def cases(self, rows: ast.AST, names: list[str], tables: dict) -> dict[str, set[str]] | None:
        """The rules each argument names across the cases a case list makes and runs, or None
        when the list cannot be evaluated."""
        try:
            made = list(
                eval(  # noqa: S307  (the repo's own test file, read against stand-ins)
                    compile(ast.Expression(rows), "<cases>", "eval"),
                    {"__builtins__": CASE_BUILTINS, "pytest": Pytest(), **tables},
                )
            )
        except Exception:  # noqa: BLE001  (a case list it cannot evaluate is read by name)
            return None
        out: dict[str, set[str]] = {name: set() for name in names}
        for row in made:
            if isinstance(row, Param):
                if any(isinstance(m, Mark) and m.name in UNRUN for m in row.marks):
                    continue
                row = row.values if len(names) > 1 else row.values[0]
            values = row if len(names) > 1 else (row,)
            if not isinstance(values, (list, tuple)):
                return None
            for name, value in zip(names, values):
                out[name] |= self.held(value)
        return out

    def local(self, fn: ast.FunctionDef, module: dict, helpers, tables) -> dict[str, set[str]]:
        env = dict(module)
        for deco in fn.decorator_list:
            if (
                isinstance(deco, ast.Call)
                and len(deco.args) >= 2
                and isinstance(deco.args[0], ast.Constant)
                and ast.unparse(deco.func).endswith("parametrize")
            ):
                names = [n.strip() for n in str(deco.args[0].value).split(",")]
                rows = deco.args[1]
                made = self.cases(rows, names, tables)
                if made is not None:
                    env |= made
                elif len(names) > 1 and isinstance(rows, (ast.List, ast.Tuple)):
                    for i, name in enumerate(names):
                        env[name] = set().union(
                            *(
                                self.named(r.elts[i], env, helpers)
                                for r in rows.elts
                                if isinstance(r, ast.Tuple) and len(r.elts) > i
                            )
                        )
                else:
                    env[names[0]] = self.named(rows, env, helpers)
        for node in ast.walk(fn):
            if isinstance(node, (ast.Assign, ast.AnnAssign)) and node.value is not None:
                targets = node.targets if isinstance(node, ast.Assign) else [node.target]
                for t in targets:
                    for n in ast.walk(t):
                        if isinstance(n, ast.Name):
                            env[n.id] = env.get(n.id, set()) | self.named(node.value, env, helpers)
        return env

    def read(self, path: Path) -> None:
        tree = ast.parse(path.read_text(encoding="utf8"))
        module: dict[str, set[str]] = {}
        helpers: dict[str, set[str]] = {}
        tables: dict = {}
        for node in tree.body:
            if isinstance(node, ast.Assign):
                for t in node.targets:
                    if isinstance(t, ast.Name):
                        module[t.id] = self.table(node.value, module, helpers)
                        tables[t.id] = shape(node.value, tables)
        functions = [n for n in tree.body if isinstance(n, ast.FunctionDef)]
        # A helper may return another helper's rules, so read them all again until none returns
        # more.
        changed = True
        while changed:
            changed = False
            for fn in functions:
                env = self.local(fn, module, helpers, tables)
                returned = set().union(
                    *(
                        self.named(r.value, env, helpers)
                        for r in ast.walk(fn)
                        if isinstance(r, ast.Return) and r.value is not None
                    )
                )
                if returned != helpers.get(fn.name, set()):
                    helpers[fn.name] = returned
                    changed = True
        for fn in functions:
            if any(unrun(d) for d in fn.decorator_list):
                continue
            env = self.local(fn, module, helpers, tables)
            for node in ast.walk(fn):
                if isinstance(node, ast.Assert):
                    for rule, absent in self.claims(node.test, False, env, helpers):
                        (self.absent if absent else self.present)[rule].add(fn.name)

    def claims(self, node: ast.AST, negated: bool, env, helpers) -> set[tuple[str, bool]]:
        """What an assert's test asserts, as (rule, whether asserted absent) pairs."""
        if isinstance(node, ast.BoolOp):
            return set().union(*(self.claims(v, negated, env, helpers) for v in node.values))
        if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.Not):
            return self.claims(node.operand, not negated, env, helpers)
        if isinstance(node, ast.IfExp):  # each branch holds only where its condition does
            body = self.claims(node.body, negated, env, helpers)
            return body & self.claims(node.orelse, negated, env, helpers)
        absent = negated != self.denies(node)
        return {(rule, absent) for rule in self.named(node, env, helpers)}

    @staticmethod
    def denies(node: ast.AST) -> bool:
        """Whether a comparison asserts its rules absent: `not in`, or equal to an empty literal."""
        if not isinstance(node, ast.Compare):
            return False
        empty = [
            n
            for n in [node.left, *node.comparators]
            if isinstance(n, (ast.List, ast.Tuple, ast.Set))
            and not n.elts
            or isinstance(n, ast.Dict)
            and not n.keys
        ]
        return any(isinstance(op, ast.NotIn) for op in node.ops) or bool(empty)


def documented() -> set[str]:
    return {
        name
        for doc in (SKILL / "references").glob("*.md")
        for name in BRACKETED.findall(doc.read_text())
    }


def unread_units() -> list[str]:
    """Units of cadrev.units.UNITS that no row of the tests' UNITS table reads."""
    rows = None
    for path in TESTS.glob("test_*.py"):
        for node in ast.parse(path.read_text(encoding="utf8")).body:
            if isinstance(node, ast.Assign) and any(
                isinstance(t, ast.Name) and t.id == "UNITS" for t in node.targets
            ):
                rows = ast.literal_eval(node.value)
    if rows is None:
        return ["(the tests have no UNITS table)"]
    read = {
        unit
        for quote, (value, _) in rows.items()
        for v, unit in sources.quantities_in(quote)
        if math.isclose(v, value, rel_tol=1e-9)
    }
    return [u for u in units.UNITS if u not in read]


def unsorted_findings() -> list[str]:
    """The first FINDINGS row whose rule sorts before the row above it, and where it belongs."""
    for path in sorted(TESTS.glob("test_*.py")):
        for node in ast.parse(path.read_text(encoding="utf8")).body:
            if (
                isinstance(node, ast.Assign)
                and any(isinstance(t, ast.Name) and t.id == "FINDINGS" for t in node.targets)
                and isinstance(node.value, ast.Dict)
            ):
                keys = [k.value for k in node.value.keys if isinstance(k, ast.Constant)]
                for above, row in zip(keys, keys[1:]):
                    if row < above:
                        others = sorted(k for k in keys if k != row)
                        at = bisect.bisect_left(others, row)
                        after, before = others[at - 1 : at] or [None], others[at : at + 1] or [None]
                        if after[0] is None:
                            where = f"first, above [{before[0]}]"
                        elif before[0] is None:
                            where = f"last, below [{after[0]}]"
                        else:
                            where = f"between [{after[0]}] and [{before[0]}]"
                        return [
                            f"FINDINGS row [{row}] sorts before [{above}] above it; move it {where}"
                        ]
    return []


def fixture(node: ast.AST) -> bool:
    """Whether node is fixture text: a module constant (MODEL, _SLOT), a file's read_text(), or an
    edit of either."""
    if isinstance(node, ast.Name):
        return node.id.lstrip("_").isupper()
    if not isinstance(node, ast.Call):
        return False
    func = node.func
    if isinstance(func, ast.Attribute):
        return func.attr == "read_text" or (func.attr == "replace" and fixture(func.value))
    return (
        isinstance(func, ast.Name)
        and func.id == "swap"
        and bool(node.args)
        and fixture(node.args[0])
    )


def unchecked_edits() -> list[str]:
    """Each edit of fixture text in the tests by str.replace or re.sub, which leave it unchanged
    when the text to replace is absent."""
    out = []
    for path in sorted(TESTS.rglob("*.py")):
        calls = [
            n
            for n in ast.walk(ast.parse(path.read_text(encoding="utf8")))
            if isinstance(n, ast.Call)
        ]
        for node in sorted(calls, key=lambda n: (n.lineno, n.col_offset)):
            if not isinstance(node.func, ast.Attribute):
                continue
            func = node.func
            if func.attr == "replace" and fixture(func.value):
                name = "replace"
            elif (
                func.attr in ("sub", "subn")
                and ast.unparse(func.value) == "re"
                and len(node.args) > 2
                and fixture(node.args[2])
            ):
                name = f"re.{func.attr}"
            else:
                continue
            out.append(f"{path.relative_to(REPO)}:{node.lineno}: edits a fixture with {name}")
    return out


def main() -> int:
    rules = emitted()
    asserts = Asserts(rules)
    for path in sorted(TESTS.glob("test_*.py")):
        asserts.read(path)
    problems = []
    for rule in sorted(rules):
        if os.environ.get("LIST"):
            print(
                f"{rule}\n  present: {', '.join(sorted(asserts.present[rule])) or '-'}"
                f"\n  absent:  {', '.join(sorted(asserts.absent[rule])) or '-'}"
            )
        missing = [
            k
            for k, side in (("present", asserts.present), ("absent", asserts.absent))
            if not side[rule]
        ]
        if missing:
            problems.append(f"[{rule}] no test asserts it {' or '.join(missing)}")
    problems += [
        f"[{rule}] is not documented as [{rule}] in references/*.md"
        for rule in sorted(rules - documented())
    ]
    problems += [
        f"[{rule}] is an error no completion criterion of SKILL.md names, "
        f"as [{rule}] or a [prefix-*]"
        for rule in unheld_errors()
    ]
    problems += unsorted_findings()
    problems += [f"unit {u} is read by no row of the tests' UNITS table" for u in unread_units()]
    problems += [
        f"{where}; use swap, which fails when the text it replaces is absent"
        for where in unchecked_edits()
    ]
    print(
        f"{len(rules)} rules emitted; "
        f"{sum(bool(asserts.present[r] and asserts.absent[r]) for r in rules)} "
        "asserted both present and absent"
    )
    for p in problems:
        print(p)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
