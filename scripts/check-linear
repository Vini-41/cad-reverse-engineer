#!/usr/bin/env python3
"""Fail when the commits a branch brings hold a merge commit.

A PR lands on main by `gh pr merge --rebase`, which replays each commit and can't replay a merge,
so a branch is kept linear: a ticket branch is rebased onto its integration branch's tip, never
merged. The commits checked are BASE..HEAD, BASE by default the merge-base with main. A BASE of
the null commit, or one not in this clone, compares nothing and passes with a note. Prints each
merge commit and exits 1 if there is one.

    scripts/check-linear
"""

import os
import subprocess
import sys


def git(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", *args], capture_output=True, text=True)


def main() -> int:
    base = os.environ.get("BASE") or git("merge-base", "HEAD", "main").stdout.strip()
    if (
        not base
        or set(base) == {"0"}
        or git("rev-parse", "-q", "--verify", f"{base}^{{commit}}").returncode
    ):
        print(
            f"BASE {base or '(none)'} names no commit here, so there is nothing to compare",
            file=sys.stderr,
        )
        return 0
    merges = git("log", "--merges", "--format=%h %s", f"{base}..HEAD").stdout.splitlines()
    if not merges:
        return 0
    for merge in merges:
        print(merge)
    print(
        "a merge commit can't be replayed by `gh pr merge --rebase`: rebase the branch onto its "
        "base instead of merging it in"
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
