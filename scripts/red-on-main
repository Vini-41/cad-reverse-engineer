#!/usr/bin/env bash
# Run this working tree's tests, with its docs and examples, against the tool source and its
# launcher (the skill's cadrev script) as they were before the fix: those that go red there are
# holes the fix closes, those that stay green are guards, named test_guard_*. Prints
# the counts and each misnamed test, and exits 1 if there is one: a test_guard_* that goes red, or
# a test function new since BASE that stays green without the name. It exits 2 if pytest ran no
# test, so a missing pytest or an empty selection never reads as a clean comparison, and 3 if there
# is nothing to compare: BASE is HEAD with the tool source and launcher unchanged, no test function is new or
# changed since BASE, or BASE is not in this clone (the null commit a new branch's push names, or a
# commit a force-push dropped), or BASE holds no tool source at plugin/ (it predates the move there).
# 0 is a clean comparison. New rows of a test function BASE already has (the QUOTES, UNITS and
# FINDINGS tables) carry near misses, so only their red guards count.
#
#   scripts/red-on-main [pytest args, e.g. -k units]     LIST=1 also lists every test as red or green
#
# With no pytest args it runs the test functions new since BASE or edited in its diff. A row added
# to a table (QUOTES, UNITS, FINDINGS) edits the table, not the test that reads it: pass -k for those.
# pytest's -k rejects a row id holding * (19*12.5 mm), so name the function that reads the table
# there; LIST=1 then names each row red or green.
#
# BASE is the commit before the fix. On main it is the upstream (origin/main), so unpushed
# commits on main count as the fix. Any other branch, pushed or not, compares against the commit
# its reflog says it was created at, so a branch cut from an integration branch counts only its
# own commits as the fix; without that record, or once the branch has merged a later main or been
# rebased, it compares against its merge-base with main. Set BASE=<ref> to compare against another
# commit.
set -euo pipefail

repo=$(git rev-parse --show-toplevel)
tool="$repo/plugin/skills/cad-reverse-engineer/tool"
tests="$repo/tests"
if [ -n "${BASE:-}" ]; then
  label=$BASE
  if [[ "$BASE" =~ ^0+$ ]]; then
    echo "BASE is the null commit, as on a new branch's first push, so there is no fix to compare" >&2
    exit 3
  elif ! base=$(git -C "$repo" rev-parse -q --verify "$BASE^{commit}"); then
    echo "BASE $BASE is not in this clone (a force-push may have dropped it), so there is no fix to compare" >&2
    exit 3
  fi
elif [ "$(git -C "$repo" symbolic-ref -q --short HEAD || true)" = main ] &&
  base=$(git -C "$repo" rev-parse -q --verify "@{upstream}" 2>/dev/null); then
  label=upstream
else
  label="merge-base with main"
  base=$(git -C "$repo" merge-base HEAD main)
  # The commit the branch was created at, from the oldest entry of its reflog, when that entry
  # records the creation and the branch still contains it (a rebase drops it).
  branch=$(git -C "$repo" symbolic-ref -q --short HEAD || true)
  created=$( [ -z "$branch" ] || git -C "$repo" log -g --format='%H %gs' "refs/heads/$branch" -- 2>/dev/null | tail -n 1 || true)
  if [[ "$created" == *" branch: Created from "* ]] && created=${created%% *} &&
    git -C "$repo" merge-base --is-ancestor "$base" "$created" &&
    git -C "$repo" merge-base --is-ancestor "$created" HEAD; then
    label="the commit $branch was created at"
    base=$created
  fi
fi
if [ "$base" = "$(git -C "$repo" rev-parse HEAD)" ] && git -C "$repo" diff --quiet HEAD -- "$tool/src" "$tool/../cadrev"; then
  echo "BASE is HEAD and the tool source is unchanged, so there is no fix to compare; set BASE=<ref>" >&2
  exit 3
fi

if ! git -C "$repo" cat-file -e "$base:plugin/skills/cad-reverse-engineer/tool/src" 2>/dev/null; then
  echo "$label has no tool source at plugin/skills/cad-reverse-engineer/tool/src (it predates the move there), so there is no fix to compare" >&2
  exit 3
fi

tree=$(mktemp -d)
trap 'git -C "$repo" worktree remove --force "$tree" >/dev/null 2>&1 || true; rm -f "$tree.existing" "$tree.patch" "$tree.log"' EXIT
git -C "$repo" worktree add --detach --quiet "$tree" "$base"
# Everything but the tool source and its launcher comes from the working tree: the tests read the
# READMEs and examples too.
git -C "$repo" diff --binary "$base" -- . ":(exclude)plugin/skills/cad-reverse-engineer/tool/src" \
  ":(exclude)plugin/skills/cad-reverse-engineer/cadrev" >"$tree.patch"
[ -s "$tree.patch" ] && git -C "$tree" apply --whitespace=nowarn "$tree.patch"
rm -rf "$tree/tests"
cp -R "$tests" "$tree/tests"

echo "working tree, but tool source and launcher from $label ($(git -C "$repo" rev-parse --short "$base"))"
existing="$tree.existing"  # the test functions BASE already has
git -C "$repo" grep -hoE '^def test_[A-Za-z0-9_]+' "$base" -- "$tests" | sed 's/^def //' >"$existing" || true
if [ $# -eq 0 ]; then
  # Select the test functions new since BASE, and those whose lines (decorators to last line) the
  # diff touches. A hunk's @@ header names the function above an insertion, so it is not used.
  selected=$( { grep -hoE '^def test_[A-Za-z0-9_]+' "$tests"/*.py | sed 's/^def //' | grep -vxFf "$existing"
                git -C "$repo" diff -U0 "$base" -- "$tests" | python3 -c '
import ast, re, sys
repo, changed, path = sys.argv[1], {}, None
for line in sys.stdin:
    if line.startswith("+++ "):
        path = None if line.startswith("+++ /dev/null") else line[6:].rstrip("\n")
    elif (m := re.match(r"@@ -\S+ \+(\d+)(?:,(\d+))? @@", line)) and path:
        start, count = int(m[1]), int(m[2] or 1)
        changed.setdefault(path, set()).update(range(start, start + max(count, 1)))
for path, lines in changed.items():
    for node in ast.parse(open(f"{repo}/{path}", encoding="utf8").read()).body:
        if isinstance(node, ast.FunctionDef) and node.name.startswith("test_"):
            first = min([node.lineno] + [d.lineno for d in node.decorator_list])
            if any(first <= n <= node.end_lineno for n in lines):
                print(node.name)
' "$repo"
              } | sort -u || true)
  if [ -z "$selected" ]; then
    echo "no test function is new or changed since $label; pass -k to choose tests" >&2
    exit 3
  fi
  set -- -k "$(echo "$selected" | paste -sd ' ' - | sed 's/ / or /g')"
  echo "running the $(echo "$selected" | wc -l | tr -d ' ') test functions new or changed since $label"
fi
cd "$tree"
# PYTHONPATH puts the base's src ahead of the editable install of the working tree's.
log="$tree.log"
code=0
PYTHONPATH="$tree/plugin/skills/cad-reverse-engineer/tool/src" uv run --project "$tool" python -m pytest -v --tb=no -p no:cacheprovider tests "$@" >"$log" 2>&1 || code=$?
results=$(sed -nE 's/^(.+) (FAILED|ERROR) +\[ *[0-9]+%\]$/red    \1/p; s/^(.+) PASSED +\[ *[0-9]+%\]$/green  \1/p' "$log" | sort || true)
# pytest exits 1 when a test fails, which is a hole; any other failure, or exit 1 with no test run
# (pytest missing from the tool's environment), means nothing was compared, so say so and fail.
if { [ "$code" -ne 0 ] && [ "$code" -ne 1 ]; } || { [ "$code" -eq 1 ] && [ -z "$results" ]; }; then
  tail -n 20 "$log" >&2
  echo "pytest ran no test against $label (exit $code), so nothing was compared; is pytest in the tool's environment (uv sync --extra test)?" >&2
  exit 2
fi
[ -n "${LIST:-}" ] && echo "$results"
echo "$results" | awk '
  FNR == NR { old[$1] = 1; next }
  NF == 0 { next }
  { fn = $2; sub(/^.*::/, "", fn); sub(/\[.*$/, "", fn); guard = fn ~ /^test_guard_/
    count[$1]++
    if ($1 == "red" && guard) bad[++m] = "red guard (rename without test_guard_): " $2
    if ($1 == "green" && !guard && !(fn in old)) bad[++m] = "green, not a guard (name it test_guard_): " $2 }
  END { printf "%d red (holes), %d green\n", count["red"], count["green"]
        for (i = 1; i <= m; i++) print "misnamed  " bad[i]
        exit m > 0 }' "$existing" -
