#!/usr/bin/env bash
# Run this working tree's tests against the tool source as it was before the fix: those that go
# red there are holes the fix closes, those that stay green are guards, named test_guard_*. Prints
# the counts and each misnamed test, and exits 1 if there is one: a test_guard_* that goes red, or
# a test function new since BASE that stays green without the name. New rows of a test function
# BASE already has (the QUOTES and UNITS tables) carry near misses, so only their red guards count.
#
#   scripts/red-on-main [pytest args, e.g. -k units]     LIST=1 also lists every test as red or green
#
# BASE is the commit before the fix: by default the upstream branch (origin/main), so unpushed
# commits on main count as the fix. Set BASE=<ref> to compare against another commit.
set -euo pipefail

repo=$(git rev-parse --show-toplevel)
tool="$repo/skills/cad-reverse-engineer/tool"
upstream="@{upstream}"
base=$(git -C "$repo" rev-parse "${BASE:-$upstream}")
if [ "$base" = "$(git -C "$repo" rev-parse HEAD)" ] && git -C "$repo" diff --quiet HEAD -- "$tool/src"; then
  echo "BASE is HEAD and the tool source is unchanged, so there is no fix to compare; set BASE=<ref>" >&2
  exit 2
fi

tree=$(mktemp -d)
trap 'git -C "$repo" worktree remove --force "$tree" >/dev/null 2>&1 || true; rm -f "$tree.existing"' EXIT
git -C "$repo" worktree add --detach --quiet "$tree" "$base"
rm -rf "$tree/skills/cad-reverse-engineer/tool/tests"
cp -R "$tool/tests" "$tree/skills/cad-reverse-engineer/tool/tests"

echo "tests from the working tree, tool source from ${BASE:-upstream} ($(git -C "$repo" rev-parse --short "$base"))"
existing="$tree.existing"  # the test functions BASE already has
git -C "$repo" grep -hoE '^def test_[A-Za-z0-9_]+' "$base" -- "$tool/tests" | sed 's/^def //' >"$existing" || true
cd "$tree/skills/cad-reverse-engineer/tool"
# PYTHONPATH puts the base's src ahead of the editable install of the working tree's.
results=$(PYTHONPATH="$PWD/src" uv run --project "$tool" python -m pytest -v --tb=no -p no:cacheprovider "$@" \
  | sed -nE 's/^(.+) (FAILED|ERROR) +\[ *[0-9]+%\]$/red    \1/p; s/^(.+) PASSED +\[ *[0-9]+%\]$/green  \1/p' \
  | sort || true)
[ -n "${LIST:-}" ] && echo "$results"
echo "$results" | awk '
  FNR == NR { old[$1] = 1; next }
  NF == 0 { next }
  { fn = $2; sub(/^.*::/, "", fn); sub(/\[.*$/, "", fn); guard = fn ~ /^test_guard_/
    count[$1]++
    if ($1 == "red" && guard) bad[++m] = "red guard (rename without test_guard_): " $2
    if ($1 == "green" && !guard && !(fn in old)) bad[++m] = "green, not a guard (name it test_guard_): " $2 }
  END { printf "%d red (holes), %d green\n", count["red"], count["green"]
        for (i = 1; i <= m; i++) print "misnamed  " bad[i]
        exit m > 0 }' "$existing" -
