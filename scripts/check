#!/usr/bin/env bash
# CI run locally: every step of .github/workflows/test.yml, which calls this script. Runs each step,
# prints the ones that failed, each with the last 20 lines of its output, and exits 1 if any did.
#
#   scripts/check
#   scripts/check --lint   # pyright and ruff alone, in seconds, for after an edit
#
# An example fails past EXAMPLE_SECONDS (default 150, about the slowest CI runner's time for
# examples/legclaw with room to spare).
#
# The plugin manifests are validated only where the `claude` CLI is installed; CI installs it.
set -uo pipefail
# Bash reads a script as it runs it; inside these braces it parses the whole file first, so an edit
# made while the check runs takes effect on the next run.
{

case "${1-}" in
  "") mode=full ;;
  --lint) mode=lint ;;
  *) echo "usage: scripts/check [--lint]" >&2; exit 2 ;;
esac

repo=$(cd "$(dirname "$0")/.." && pwd)
# This clone runs the repo's git hooks (.githooks) unless it already uses others.
[ -n "$(git -C "$repo" config core.hooksPath)" ] || git -C "$repo" config core.hooksPath .githooks
cd "$repo/skills/cad-reverse-engineer/tool" || exit 2
# The test extra holds pytest, pyright and ruff, which CI installs with the same sync; a new
# worktree has no environment until this runs.
uv sync --locked --extra test || { echo "uv sync --locked --extra test failed, so no step ran"; exit 1; }
failed=()
failed_logs=() # each failed step's output, whose end the summary reprints under its name
failed_reruns=() # each failed step's command, run alone from the repo root
logs=$(mktemp -d)
steps=0
trap 'rm -rf "$logs"' EXIT

# step NAME [--rerun COMMAND] CMD...: COMMAND, from the repo root, runs the step alone; by default
# CMD in the tool directory. A step that runs a function here names its COMMAND.
step() {
  local name=$1 rerun log
  shift
  rerun="(cd skills/cad-reverse-engineer/tool && $*)"
  if [ "$1" = --rerun ]; then rerun=$2; shift 2; fi
  steps=$((steps + 1))
  log="$logs/$steps"
  echo "== $name"
  "$@" 2>&1 | tee "$log"
  [ "${PIPESTATUS[0]}" -eq 0 ] || { failed+=("$name"); failed_logs+=("$log"); failed_reruns+=("$rerun"); }
}

# Fails unless cadrev check on example prints the status line its README states, within
# EXAMPLE_SECONDS.
example_status() {
  local example=$1 expected log code=0 start took budget=${EXAMPLE_SECONDS:-150}
  expected=$(sed -n 's/^Expected status: `\(.*\)`$/\1/p' "$example/README.md")
  [ -n "$expected" ] || { echo "$example/README.md states no expected status"; return 1; }
  log=$(mktemp)
  start=$SECONDS
  uv run cadrev check "$example" | tee "$log"
  took=$((SECONDS - start))
  grep -qF "$expected. Report:" "$log" || { echo "expected: $expected"; code=1; }
  rm -f "$log"
  echo "examples/$(basename "$example") took $took s"
  if [ "$took" -gt "$budget" ]; then
    echo "examples/$(basename "$example") took $took s, over the $budget s an example may take: make it faster"
    code=1
  fi
  return "$code"
}

# Runs red-on-main for real against BASE (CI sets it from the event; locally it defaults to the
# upstream). Its exit 3, nothing to compare, passes with a notice that GitHub shows.
red_on_main_or_notice() {
  local log code=0
  log=$(mktemp)
  ../../../scripts/red-on-main 2>"$log" || code=$?
  cat "$log" >&2
  if [ "$code" -eq 3 ]; then
    echo "::notice title=red-on-main compared nothing::$(tail -n 1 "$log")"
    code=0
  fi
  rm -f "$log"
  return "$code"
}

plugin_validate() {
  if command -v claude >/dev/null; then
    (cd "$repo" && claude plugin validate .)
  else
    echo "skipped: no claude CLI on PATH"
  fi
}

left_out="$logs/left-out"
red_count=""
step "pyright" uv run pyright
step "ruff check" uv run ruff check ../../..
step "ruff format" uv run ruff format --check ../../..
# --lint stops here, past the steps an edit most often fails.
if [ "$mode" = full ]; then
  step "tool tests" uv run pytest -q
  step "script tests" uv run pytest -q ../../../scripts/tests
  step "agent-facing docs point only at files that exist" ../../../scripts/check-doc-pointers
  step "every rule is tested raised and not raised, documented and held by a step; tests use only the CLI and edit fixtures through swap" \
    uv run python ../../../scripts/rule-coverage
  step "the skill and tool source use none of GLOSSARY.md's avoided words" ../../../scripts/check-glossary-words
  step "the tool source branches on a check or probe kind only in run_checks" ../../../scripts/check-kind-branches
  step "the branch holds no merge commit, so it rebase-merges" ../../../scripts/check-linear
  step "plugin manifests validate" --rerun "claude plugin validate ." plugin_validate
  step "red-on-main: new tests are red holes or green guards" --rerun scripts/red-on-main \
    red_on_main_or_notice
  # Its count, repeated at the end, past the examples' output.
  red_count=$(grep -E '^[0-9]+ red \(holes\), [0-9]+ green$' "$logs/$steps" | tail -n 1)
  # The examples as a clone after committing holds them: tracked and staged files at their staged text.
  # The last line repeats how many edits that left out, so a pass never hides that it checked older text.
  examples=$(../../../scripts/committed-examples 2>"$left_out")
  code=$?
  cat "$left_out" >&2
  if [ "$code" -eq 0 ]; then
    # Every example is a project the copy holds; its README states the status it reaches.
    for project in "$examples"/*/project.yaml; do
      [ -e "$project" ] || continue
      example=$(basename "$(dirname "$project")")
      step "examples/$example reaches its documented status" \
        --rerun "scripts/cadrev check examples/$example" example_status "$examples/$example"
    done
    rm -rf "$(dirname "$examples")"
  else
    failed+=("the examples copy as a clone holds them")
    failed_logs+=(/dev/null)
    failed_reruns+=(scripts/committed-examples)
  fi
fi

report_red_count() {
  [ -z "$red_count" ] || echo "red-on-main: $red_count"
}

report_left_out() {
  local n s
  n=$(grep -c "^not staged, so left out of the copy: " "$left_out" 2>/dev/null)
  [ "${n:-0}" -eq 0 ] && return
  [ "$n" -eq 1 ] && s="" || s="s"
  echo "examples checked at their staged text: $n unstaged edit$s or untracked file$s left out"
}

if [ ${#failed[@]} -gt 0 ]; then
  for i in "${!failed[@]}"; do
    printf 'failed: %s\n  rerun alone: %s\n' "${failed[$i]}" "${failed_reruns[$i]}"
    tail -n 20 "${failed_logs[$i]}" | sed 's/^/  /'
  done
  report_red_count
  report_left_out
  exit 1
fi
echo "all steps passed"
report_red_count
report_left_out
exit
}
