#!/usr/bin/env bash
# The repo's only CI, run locally: green before every commit and on a PR's head before it merges.
# Starts every step at once, each in its own process, and prints each step's output under its name
# and time, in the order below, once it and the steps above it have finished; lists the ones that
# failed, each with the last 20 lines of its output, and exits 1 if any did. The tool tests and script
# tests run on several workers (pytest-xdist).
#
#   scripts/check
#   scripts/check --lint   # pyright and ruff alone, in seconds, for after an edit
#
# An example fails past EXAMPLE_SECONDS (default 600). Review holds each example to a goal a user
# feels, a full cadrev check in about 2 minutes on a laptop; this ceiling only catches a large
# regression, so it is not tuned to the slowest example. A step's time is wall-clock beside the other
# steps, so an example's reads a little above the example run alone; the slowest example bounds how
# long the whole check takes.
#
# The plugin manifests are validated only where the `claude` CLI is installed.
set -uo pipefail
# Bash reads a script as it runs it; inside these braces it parses the whole file first, so an edit
# made while the check runs takes effect on the next run.
{

case "${1-}" in
  "") mode=full ;;
  --lint) mode=lint ;;
  *) echo "usage: scripts/check [--lint]" >&2; exit 2 ;;
esac

repo=$(cd "$(dirname "$0")/.." && pwd)
# This clone runs the repo's git hooks (.githooks) unless it already uses others.
[ -n "$(git -C "$repo" config core.hooksPath)" ] || git -C "$repo" config core.hooksPath .githooks
cd "$repo/plugin/skills/cad-reverse-engineer/tool" || exit 2
# The test extra holds pytest, pytest-xdist, pyright and ruff; a new worktree has no environment
# until this runs.
uv sync --locked --extra test || { echo "uv sync --locked --extra test failed, so no step ran"; exit 1; }
logs=$(mktemp -d)
copy="" # the examples copy, removed on exit
names=() # each step's name, in the order its output prints
reruns=() # each step's command, run alone from the repo root
pids=() # each running step's process, which leads its own process group
failed=() # each failed step's index
# Each step leads its own process group, so an interrupted check stops every step it started.
set -m
stop() {
  local pid
  for pid in ${pids[@]+"${pids[@]}"}; do kill -TERM -- "-$pid" 2>/dev/null; done
  wait # so no step still writes into the logs or the examples copy as they are removed
  rm -rf "$logs" ${copy:+"$copy"}
}
trap stop EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# step NAME [--rerun COMMAND] CMD...: starts CMD in the tool directory, its output to its own log and
# its time in whole seconds beside it; COMMAND, from the repo root, runs the step alone. A step that
# runs a function here names its COMMAND.
step() {
  local name=$1 rerun log="$logs/${#names[@]}"
  shift
  rerun="(cd plugin/skills/cad-reverse-engineer/tool && $*)"
  if [ "$1" = --rerun ]; then rerun=$2; shift 2; fi
  (
    start=$SECONDS
    "$@"
    code=$?
    echo $((SECONDS - start)) >"$log.seconds"
    exit "$code"
  ) </dev/null >"$log" 2>&1 &
  pids+=("$!")
  names+=("$name")
  reruns+=("$rerun")
}

# Fails unless cadrev check on example prints the status line its README states, within
# EXAMPLE_SECONDS.
example_status() {
  local example=$1 expected log code=0 start took budget=${EXAMPLE_SECONDS:-600}
  expected=$(sed -n 's/^Expected status: `\(.*\)`$/\1/p' "$example/README.md")
  [ -n "$expected" ] || { echo "$example/README.md states no expected status"; return 1; }
  log=$(mktemp)
  start=$SECONDS
  uv run cadrev check "$example" | tee "$log"
  took=$((SECONDS - start))
  grep -qF "$expected. Report:" "$log" || { echo "expected: $expected"; code=1; }
  rm -f "$log"
  if [ "$took" -gt "$budget" ]; then
    echo "examples/$(basename "$example") took $took s, over the $budget s an example may take: make it faster"
    code=1
  fi
  return "$code"
}

# The marketplace validates, and so does the plugin it ships from plugin/.
plugin_validate() {
  if command -v claude >/dev/null; then
    (cd "$repo" && claude plugin validate . && claude plugin validate plugin)
  else
    echo "skipped: no claude CLI on PATH"
  fi
}

left_out="$logs/left-out"
if [ "$mode" = full ]; then
  # The examples as a clone after committing holds them: tracked and staged files at their staged
  # text. The last line repeats how many edits that left out, so a pass never hides that it checked
  # older text.
  examples=$(../../../../scripts/committed-examples 2>"$left_out")
  examples_code=$?
  cat "$left_out" >&2
  [ "$examples_code" -ne 0 ] || copy=$(dirname "$examples")
fi
step "pyright" uv run pyright -p ../../../../pyrightconfig.json
step "ruff check" uv run ruff check ../../../..
step "ruff format" uv run ruff format --check ../../../..
# --lint stops here, past the steps an edit most often fails.
if [ "$mode" = full ]; then
  # Fixed worker counts, not -n auto (a worker per core): the examples run beside the tests, the
  # slowest of them longest, so the tests take about half of a laptop's cores and finish first.
  step "tool tests" uv run pytest -q -n 6 ../../../../tests
  step "script tests" uv run pytest -q -n 4 ../../../../scripts/tests
  step "agent-facing docs point only at files that exist" ../../../../scripts/check-doc-pointers
  step "plugin manifests validate" --rerun "claude plugin validate . && claude plugin validate plugin" plugin_validate
  if [ "$examples_code" -eq 0 ]; then
    # Every example is a project the copy holds; its README states the status it reaches.
    for project in "$examples"/*/project.yaml; do
      [ -e "$project" ] || continue
      example=$(basename "$(dirname "$project")")
      step "examples/$example reaches its documented status" \
        --rerun "scripts/cadrev check examples/$example" example_status "$examples/$example"
    done
  fi
fi

# Each step's output under its name and time, in the order the steps were started.
for i in "${!names[@]}"; do
  wait "${pids[$i]}"
  code=$?
  echo "== ${names[$i]} ($(cat "$logs/$i.seconds" 2>/dev/null || echo "?") s)"
  cat "$logs/$i"
  [ "$code" -eq 0 ] || failed+=("$i")
done
pids=()
if [ "$mode" = full ] && [ "$examples_code" -ne 0 ]; then
  : >"$logs/${#names[@]}"
  failed+=("${#names[@]}")
  names+=("the examples copy as a clone holds them")
  reruns+=(scripts/committed-examples)
fi

report_left_out() {
  local n s
  n=$(grep -c "^not staged, so left out of the copy: " "$left_out" 2>/dev/null)
  [ "${n:-0}" -eq 0 ] && return
  [ "$n" -eq 1 ] && s="" || s="s"
  echo "examples checked at their staged text: $n unstaged edit$s or untracked file$s left out"
}

if [ ${#failed[@]} -gt 0 ]; then
  for i in "${failed[@]}"; do
    printf 'failed: %s\n  rerun alone: %s\n' "${names[$i]}" "${reruns[$i]}"
    tail -n 20 "$logs/$i" | sed 's/^/  /'
  done
  report_left_out
  exit 1
fi
echo "all steps passed"
report_left_out
exit
}
