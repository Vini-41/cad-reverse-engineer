#!/usr/bin/env bash
# The repo's one check: green locally before every commit and on a PR's head before it merges,
# and run by .github/workflows/check.yml on each PR and on main.
#
#   scripts/check          # lint, types and every test, the examples among them
#   scripts/check --lint   # ruff and pyright alone, in seconds, for after an edit
set -euo pipefail
cd "$(dirname "$0")/.."
uv sync -q --locked
uv run ruff check .
uv run ruff format --check .
uv run pyright
[ "${1-}" = --lint ] && exit
uv run pytest -q -n auto tests
# The marketplace and the plugin it ships validate, where the claude CLI is installed.
if command -v claude >/dev/null; then
  claude plugin validate . && claude plugin validate plugin
fi
