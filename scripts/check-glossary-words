#!/usr/bin/env python3
"""Fail when the shipped skill or the tool source uses a word GLOSSARY.md says to avoid.

Each glossary entry's `_Avoid_:` list is read; each word is matched whole, case-insensitively and
with a plural `s` or `es`, in the skill's SKILL.md, its references/ and the tool's src/. A word
quoted alone in backticks or double quotes (`springref`, "springref") is a name, such as another
program's attribute, and passes. A word
with a parenthetical (`check (for the whole run)`) is avoided in one sense only, and the words in
COMMON are used in another sense throughout, so neither can be found by matching and both are
left to review. Prints file:line: "word": say <term> for each use and exits 1 if there is one.

    scripts/check-glossary-words [repo root, default this script's repo]
"""

import re
import sys
from pathlib import Path

SCANNED = (
    "skills/cad-reverse-engineer/SKILL.md",
    "skills/cad-reverse-engineer/references/**/*",
    "skills/cad-reverse-engineer/tool/src/**/*",
)
# Avoided in the sense the glossary names, but ordinary words in another: a joint named `input`, a
# scale `reference`, a source that states, a test rig, sources that measure their angles, copying
# a file, a plot marker, text extraction, a .gitignore.
COMMON = {
    "copy",
    "extraction",
    "ignore",
    "input",
    "marker",
    "measure",
    "reference",
    "state",
    "test",
}


def avoided(glossary: str) -> dict[str, str]:
    """{avoided word: the glossary term to say instead}."""
    words, term = {}, None
    for line in glossary.splitlines():
        if heading := re.match(r"\*\*(.+?)\*\*:", line):
            term = heading[1]
        elif (avoid := re.match(r"_Avoid_:\s*(.*)", line)) and term:
            for word in re.split(r",\s*(?![^()]*\))", avoid[1]):
                word = word.strip()
                if word and "(" not in word and word.lower() not in COMMON:
                    words[word] = term
    return words


def _quoted(line: str, start: int, end: int) -> bool:
    """Whether line[start:end] stands alone between backticks or double quotes: a name."""
    return start > 0 and end < len(line) and line[start - 1] == line[end] and line[end] in '`"'


def main() -> int:
    root = Path(sys.argv[1] if len(sys.argv) > 1 else Path(__file__).resolve().parents[1])
    words = avoided((root / "GLOSSARY.md").read_text(encoding="utf8"))
    if not words:
        return 0
    pattern = re.compile(
        r"\b(" + "|".join(map(re.escape, sorted(words, key=len, reverse=True))) + r")(?:e?s)?\b",
        re.I,
    )
    terms = {word.lower(): term for word, term in words.items()}
    files = sorted({path for glob in SCANNED for path in root.glob(glob) if path.is_file()})
    found = []
    for path in files:
        try:
            text = path.read_text(encoding="utf8")
        except UnicodeDecodeError:
            continue
        for number, line in enumerate(text.splitlines(), 1):
            for match in pattern.finditer(line):
                if _quoted(line, match.start(), match.end()):
                    continue
                term = terms[match[1].lower()]
                found.append(f'{path.relative_to(root)}:{number}: "{match[0]}": say {term}')
    for line in found:
        print(line)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main())
